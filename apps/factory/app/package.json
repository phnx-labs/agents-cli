{
  "name": "agents-dbg",
  "version": "0.1.0",
  "private": true,
  "description": "Private install-only Mac app for debugging agents work streams",
  "author": "Muqsit Nawaz <dev@muqsitnawaz.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/phnx-labs/agents-cli",
    "directory": "apps/factory/app"
  },
  "main": "dist/main.js",
  "scripts": {
    "build:ui": "cd ../ui && bunx vite build --config vite.standalone.config.ts",
    "build:host": "bun build ./main.ts --target=node --format=cjs --outfile=./dist/main.js --external electron && bun build ./preload.ts --target=node --format=cjs --outfile=./dist/preload.js --external electron",
    "build": "bun run build:ui && bun run build:host",
    "typecheck": "bunx tsc -p ./tsconfig.json --noEmit",
    "dist": "electron-builder",
    "start": "electron ./dist/main.js"
  },
  "build": {
    "appId": "com.phnxlabs.agents-dbg",
    "productName": "agents-dbg",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../out/app-ui", "to": "app-ui" },
      { "from": "../assets", "to": "assets" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "../assets/agents.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "../assets/agents.png",
      "category": "Development"
    },
    "win": {
      "target": ["nsis"],
      "icon": "../assets/agents.png"
    }
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
